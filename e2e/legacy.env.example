# Legacy engine settings for the e2e stack. Copy to e2e/legacy.env and adjust.
# e2e/legacy.env is git-ignored. Keys are the legacy engine's own configuration names.
# Values below are placeholders or non-secret defaults.
BPFS_STORAGE=database
BP_ENABLED_MODULES=["analytics","basic-skills","builtin","channel-web","code-editor","examples"]
BP_CONFIG_DIALOG_JANITORINTERVAL=2s
BP_CONFIG_DIALOG_TIMEOUTINTERVAL=5m
# Placeholder for the legacy engine's app secret (set your own value).
APP_SECRET=change-me-legacy-app-secret
