          "title": "image"
        },
        "actions": {
          "type": "array",
          "title": "module.builtin.actionButton",
          "items": {
            "description": "module.builtin.types.actionButton.description",
            "type": "object",
            "required": [
              "action",
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
