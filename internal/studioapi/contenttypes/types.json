          }
        },
        "markdown": {
          "type": "boolean",
          "title": "module.builtin.useMarkdown",
          "default": false,
          "$help": {
            "text": "module.builtin.markdownHelp",
            "link": "https://daringfireball.net/projects/markdown/syntax"
          }
        }
      }
    },
    "uiSchema": {}
  },
  "builtin_image": {
    "id": "builtin_image",
    "title": "image",
    "group": "Built-in Messages",
    "jsonSchema": {
      "description": "module.builtin.types.image.description",
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "$subtype": "image",
          "$filter": ".jpg, .png, .jpeg, .gif, .bmp, .tif, .tiff|image/*",
          "title": "module.builtin.types.image.title"
        },
        "title": {
          "type": "string",
          "title": "module.builtin.types.image.imageLabel",
          "description": "module.builtin.types.image.labelDesc"
        },
        "typing": {
          "type": "boolean",
          "title": "module.builtin.typingIndicator",
          "default": true
        }
      }
    },
    "uiSchema": {
      "title": {
        "ui:field": "i18n_field"
      }
    }
  },
  "builtin_file": {
    "id": "builtin_file",
    "title": "module.builtin.types.file.title",
    "group": "Built-in Messages",
    "jsonSchema": {
      "description": "module.builtin.types.file.description",
      "type": "object",
      "$subtype": "file",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "$subtype": "file",
          "$filter": ".pdf",
          "title": "module.builtin.types.file.title"
        },
        "title": {
          "type": "string",
          "title": "module.builtin.types.file.fileLabel"
        },
        "typing": {
          "type": "boolean",
          "title": "module.builtin.typingIndicator",
          "default": true
        }
      }
    },
    "uiSchema": {
      "title": {
        "ui:field": "i18n_field"
      }
    }
  }
}
